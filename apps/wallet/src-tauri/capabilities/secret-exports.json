{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "secret-exports",
  "description": "The commands that return key material, and the screen protection that guards them",
  "windows": ["main"],
  "platforms": ["windows", "macOS", "linux"],
  "permissions": [
    "allow-export-seed-phrase",
    "allow-export-seed-passphrase",
    "allow-export-seed-entropy-hex",
    "allow-export-account-seed",
    "allow-export-private-key",
    "allow-set-secret-screen"
  ]
}
