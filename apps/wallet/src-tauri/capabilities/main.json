{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main wallet window: custom titlebar, event listening, non-secret commands",
  "windows": ["main"],
  "platforms": ["windows", "macOS", "linux"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-title",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "core:window:allow-is-fullscreen",
    "clipboard-manager:allow-write-text",
    "allow-list-wallets",
    "allow-create-seed-wallet",
    "allow-import-seed-wallet",
    "allow-unlock-wallet",
    "allow-lock-wallet",
    "allow-change-password",
    "allow-update-wallet",
    "allow-delete-wallet",
    "allow-get-lock-state",
    "allow-touch-session",
    "allow-list-addresses",
    "allow-open-address-explorer",
    "allow-add-address",
    "allow-add-address-at",
    "allow-create-imported-address",
    "allow-import-private-key",
    "allow-set-address-label",
    "allow-delete-address",
    "allow-delete-key",
    "allow-validate-address",
    "allow-get-xpub",
    "allow-get-xpub-for-address",
    "allow-list-contacts",
    "allow-add-contact",
    "allow-update-contact",
    "allow-delete-contact",
    "allow-quote-fees",
    "allow-prepare-tx",
    "allow-submit-tx",
    "allow-quote-bump",
    "allow-bump-fee",
    "allow-quote-cancel",
    "allow-cancel-tx",
    "allow-delete-pending-tx",
    "allow-list-txs",
    "allow-open-tx-explorer",
    "allow-list-balances",
    "allow-list-balance-totals",
    "allow-list-prices",
    "allow-list-price-history",
    "allow-get-price-chart",
    "allow-sync-now",
    "allow-list-enabled-chains",
    "allow-set-chain-enabled",
    "allow-set-poll-interval",
    "allow-set-restore-height",
    "allow-list-endpoints",
    "allow-add-endpoint",
    "allow-delete-endpoint-override",
    "allow-set-endpoint-enabled",
    "allow-set-endpoint-pinned",
    "allow-probe-endpoint",
    "allow-get-settings",
    "allow-set-etherscan-api-key",
    "allow-set-trongrid-api-key",
    "allow-set-auto-lock-minutes",
    "allow-set-price-feed-enabled",
    "allow-set-price-chart-enabled",
    "allow-set-fiat-currency",
    "allow-set-amount-entry",
    "allow-set-proxy",
    "allow-set-backdrop",
    "allow-set-shown-asset",
    "allow-get-app-version",
    "allow-get-data-dir",
    "allow-get-startup-status",
    "allow-repair-proxy",
    "allow-get-platform",
    "allow-get-window-backdrop",
    "allow-get-window-controls",
    "allow-list-chain-metadata",
    "allow-list-asset-metadata"
  ]
}
